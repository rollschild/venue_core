---
# Runs in the `tidy` preset (cmake --workflow --preset tidy) and in the `tidy`
# check of `nix flake check`. Every warning is an error, like compiler warnings
# under -Werror: silence a false positive with // NOLINT(check-name) and a
# reason, or disable a check here for the whole project.
Checks: >
  -*,
  bugprone-*,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -misc-no-recursion,
  -portability-avoid-pragma-once,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -readability-magic-numbers,
  -cppcoreguidelines-avoid-magic-numbers,
  -misc-non-private-member-variables-in-classes,
  -cppcoreguidelines-non-private-member-variables-in-classes
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/(include|src|apps|tests)/.*'
FormatStyle: file
